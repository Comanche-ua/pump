# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Дополнительные разрешённые chat_id через запятую (опционально)
# TELEGRAM_ALLOWED_CHATS=123456789,987654321

# Режим работы: "bot" (интерактивный с меню и автосканом) или "oneshot" (один скан и выход)
RUN_MODE=bot

# Порог скоринга для сигналов (по умолчанию 62)
MIN_SCORE=62

# Минимальный суточный объём USDT для фильтрации пар (по умолчанию 1_500_000)
MIN_QUOTE_VOLUME=1500000

# Максимальный суточный рост в %, выше которого монета считается уже перегретой (по умолчанию 35)
ALREADY_PUMPED_MAX=35

# Период автосканирования в секундах (по умолчанию 300 = 5 минут)
SCAN_INTERVAL_SEC=300

# Файл хранения состояния бота (портфель, настройки, история алертов)
STATE_FILE=bot_state.json
